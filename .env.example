# TinyMCE Typer environment defaults
# Copy this file to .env for local use. Do not commit real .env files.

# Supported values: chrome, firefox, edge, remote
TINYMCE_TYPER_BROWSER=chrome

# Remote WebDriver / Selenium Grid
# Required when TINYMCE_TYPER_BROWSER=remote
TINYMCE_TYPER_REMOTE_WEBDRIVER_URL=
TINYMCE_TYPER_REMOTE_BROWSER_NAME=chrome

# Run browser without a visible window. Useful for CI, containers, and remote servers.
# Cannot be used with TINYMCE_TYPER_USE_EXISTING=true.
TINYMCE_TYPER_HEADLESS=false

TINYMCE_TYPER_BROWSER_PROFILE=
TINYMCE_TYPER_USE_EXISTING=false
TINYMCE_TYPER_DEBUGGING_PORT=9222
TINYMCE_TYPER_MARIONETTE_PORT=

# Page/editor defaults
TINYMCE_TYPER_FORCE_NAVIGATION=false
TINYMCE_TYPER_WAIT_SELECTOR=
TINYMCE_TYPER_IFRAME_ID=
TINYMCE_TYPER_EDITOR_ID=
TINYMCE_TYPER_DETECT_MULTIPLE=false

# Insertion defaults
TINYMCE_TYPER_TYPE_DELAY=0.01
TINYMCE_TYPER_BATCH=false
TINYMCE_TYPER_BATCH_SIZE=50
TINYMCE_TYPER_BATCH_DELAY=0.1
TINYMCE_TYPER_FORMATTED=false
TINYMCE_TYPER_NO_CLIPBOARD=false

# Session defaults
TINYMCE_TYPER_SESSION_FILE=tinymce_session.json
TINYMCE_TYPER_NO_SESSION=false
TINYMCE_TYPER_RESET=false
TINYMCE_TYPER_ENCRYPT_SESSION=false

# Verification defaults
TINYMCE_TYPER_NO_VERIFICATION=false
TINYMCE_TYPER_VERIFICATION_MODE=normalized-text
TINYMCE_TYPER_VERIFICATION_THRESHOLD=0.90

# Logging and diagnostics
TINYMCE_TYPER_LOG_LEVEL=INFO
TINYMCE_TYPER_LOG_FILE=
TINYMCE_TYPER_VERBOSE=false
TINYMCE_TYPER_QUIET=false

# Safety defaults
TINYMCE_TYPER_KEEP_BROWSER_OPEN=true
TINYMCE_TYPER_CLOSE_ON_COMPLETE=false
TINYMCE_TYPER_NON_INTERACTIVE=false